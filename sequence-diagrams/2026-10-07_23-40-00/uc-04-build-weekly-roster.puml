@startuml
hide footbox
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam maxMessageSize 350
skinparam sequenceMessageAlign left
skinparam BoxPadding 8
skinparam ArrowColor #263238
skinparam NoteBackgroundColor #FFFBEA
skinparam NoteBorderColor #C8BE8A
skinparam sequence {
  LifeLineBorderColor #607D8B
  ParticipantBorderColor #455A64
  ParticipantBackgroundColor #F8FAFC
  ActorBorderColor #263238
  ActorBackgroundColor #FFFFFF
  GroupBorderColor #455A64
  GroupBackgroundColor #F8FAFC
  ActivationBorderColor #455A64
  ActivationBackgroundColor #FFFFFF
}
title UC-04: Build Weekly Roster

' Scope: main success scenario and alternatives 1a, 4a, 5a, 8a, 9a.
' One allocation loop, no nested loops; maximum nesting depth 3.
' Removal (5a1-5a2) is the referenced uc-04-remove-assignment.puml.
' Three core database operations are drawn: retrieve/create roster,
' save assignment, save draft.
' Supporting reads are kept as SQL comments beside the operation that uses them.
' SQL is illustrative PostgreSQL; mappings and assumptions are in README.md.

actor Manager as manager
participant "rosterUI:RosterBoundary\nRoster Allocation Page" as rosterUI <<boundary>> #EAF4FB
participant "roster:RosterControl" as roster <<control>> #FFF3DA
participant "rules:AssignmentRuleControl" as rules <<control>> #FFF3DA
participant "staff:Staff" as staff <<entity>> #EDF6EC
participant "ambulance:Ambulance" as ambulance <<entity>> #EDF6EC
database "db:Database" as db #F1F5F9

note over manager, roster
  Manager is logged in and plans a roster week
  within the five-week planning period.
end note

' Main 1-2.
manager -> rosterUI: openAllocation(week)
activate rosterUI
rosterUI -> roster: openWeek(week)
activate roster
/'
-- Retrieve roster details and staff availability
SELECT * FROM WeekPlanningView WHERE rosterWeek = :week;
'/
roster -> db: retrieveOrCreateWeeklyRoster(week)
activate db
note right of db
-- Retrieve the selected week's roster
SELECT * FROM WeeklyRoster
WHERE rosterWeek = :week;

-- If absent, create an empty draft
INSERT INTO WeeklyRoster (rosterWeek, status)
VALUES (:week, 'draft');
end note
db -->> roster: weeklyRoster (status), planningData
deactivate db
roster -->> rosterUI: rosterView
deactivate roster

break roster status is published
  ' Alternative 1a: UC-04 ends here; nothing after this fragment runs.
  rosterUI -->> manager: published roster
  note over manager, db
    UC-04 ends. Changes to the published roster
    continue through UC-06 Amend Published Roster.
  end note
end

rosterUI -->> manager: draft slots, staff availability\nand roles requiring manpower
deactivate rosterUI

' Each pass is one Manager request. An operand is only offered once its
' earlier step has been shown, so 4a never reaches candidate allocation.
loop Manager continues allocating staff
  alt Manager selects a shift and slot
    ' Main 3-4; alternative 4a.
    manager -> rosterUI: selectSlot(shiftId, slotId)
    activate rosterUI
    rosterUI -> roster: selectSlot(shiftId, slotId)
    activate roster
/'
-- Find active, available ambulances not used by another slot in this shift
SELECT a.ambulanceNumber FROM Ambulance a
JOIN AmbulanceAvailability u ON u.ambulanceNumber = a.ambulanceNumber
WHERE a.activeStatus = 'active' AND u.shiftID = :shiftId AND u.available
AND NOT EXISTS (SELECT 1 FROM RosterSlot r
  WHERE r.ambulanceNumber = a.ambulanceNumber
    AND r.shiftID = :shiftId AND r.slotID <> :slotId);
'/
    roster -->> rosterUI: eligibleAmbulances[]
    deactivate roster
    alt eligibleAmbulances is empty
      rosterUI -->> manager: no eligible ambulance;\nanother shift or slot may be selected
    else eligibleAmbulances is not empty
      rosterUI -->> manager: eligible ambulances for the slot
    end
    deactivate rosterUI

  else eligible ambulances shown and Manager chooses a role to fill or replace
    ' Main 5-6; alternative 5a1/5a3 (replacedAssignmentId given).
    manager -> rosterUI: chooseRole(ambulanceId, role,\nreplacedAssignmentId?)
    activate rosterUI
    rosterUI -> roster: listCandidates(selection)
    activate roster
/'
-- Retrieve up to three suitable candidates with their assigned hours
SELECT staffID, availability, assignedHours, jobPreference, datedLocation
FROM CandidateOption
WHERE rosterWeek = :week AND shiftID = :shiftId AND role = :role
FETCH FIRST 3 ROWS ONLY;
'/
    roster -->> rosterUI: candidateView
    deactivate roster
    rosterUI -->> manager: up to three candidates: availability,\nassigned hours, job preference and location
    deactivate rosterUI

  else Manager removes an assigned staff member
    ' Alternative 5a1-5a2, detailed in uc-04-remove-assignment.puml.
    ref over manager, rosterUI, roster, db
      UC-04 Remove Draft Assignment
      removeAssignment(assignmentId): role requires manpower
    end ref

  else candidates shown and Manager selects a candidate
    ' Main 7-9; alternatives 8a and 9a.
    manager -> rosterUI: selectCandidate(staffId)
    activate rosterUI
    rosterUI -> roster: assignCandidate(staffId, selection)
    activate roster
/'
-- Retrieve the rule context and the ambulance's current availability
SELECT * FROM StaffRuleContext
WHERE staffID = :staffId AND rosterWeek = :week
AND shiftID = :shiftId AND ambulanceNumber = :ambulanceId;
'/
    ref over manager, rosterUI, roster, rules, staff, ambulance
      UC-13 Check Assignment Rule
      result = checkAssignment(proposal, context)
      baseControl = roster:RosterControl
    end ref
    alt result is allowed and ambulance is still available
      ' Main 9.
/'
-- Store the slot's ambulance for this shift
INSERT INTO RosterSlot (slotID, rosterWeek, shiftID, ambulanceNumber)
VALUES (:slotId, :week, :shiftId, :ambulanceId)
ON CONFLICT (slotID) DO UPDATE SET ambulanceNumber = :ambulanceId;

-- Record the assignment change in the audit log
INSERT INTO AuditEntry (actingUser, timestamp, previousValue, newValue, reason)
VALUES (:actor, :time, :previous, :new, NULL);
'/
      roster -> db: saveStaffAssignment(proposal, auditData)
      activate db
      note right of db
-- Save the assignment, replacing any staff in the role
INSERT INTO Assignment (assignmentID, slotID,
staffID, fulfilledRoles, confirmationStatus)
VALUES (:assignmentId, :slotId, :staffId,
:roles, 'confirmed')
ON CONFLICT (assignmentID)
DO UPDATE SET staffID = :staffId;
      end note
      db -->> roster: assignment, slot and audit entry saved
      deactivate db
      roster -->> rosterUI: saved(updatedSlot)
      rosterUI -->> manager: assignment saved; slot updated;\nremaining roles requiring manpower shown
    else result is allowed but ambulance has been made unavailable
      ' Alternative 9a: nothing is saved.
      roster -->> rosterUI: invalidAmbulance(slot)
      rosterUI -->> manager: draft contains an invalid ambulance assignment
    else result is prevented or cancelled
      ' Alternative 8a: nothing saved; candidates stay shown (back to step 6).
      roster -->> rosterUI: notAccepted(reason)
      rosterUI -->> manager: assignment not saved: reason;\nanother candidate may be selected
    end
    deactivate roster
    deactivate rosterUI
  end
end

' Main 10.
manager -> rosterUI: saveDraft(week)
activate rosterUI
rosterUI -> roster: saveDraft(week)
activate roster
roster -> db: saveDraftAndAudit(week, auditData)
activate db
note right of db
-- Keep this week's roster as a draft
UPDATE WeeklyRoster SET status = 'draft'
WHERE rosterWeek = :week;

-- Record saving of the current draft
INSERT INTO AuditEntry (actingUser,
timestamp, previousValue, newValue, reason)
VALUES (:actor, :time, :previous, :new, :reason);
end note
db -->> roster: roster retained as draft; audit entry stored
deactivate db
roster -->> rosterUI: draftSaved
deactivate roster
rosterUI -->> manager: weekly roster saved as draft;\nunfilled roles require manpower
deactivate rosterUI
@enduml
