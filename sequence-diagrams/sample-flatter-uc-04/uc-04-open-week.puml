@startuml
hide footbox
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam maxMessageSize 350
skinparam sequenceMessageAlign left
skinparam BoxPadding 8
skinparam ArrowColor #263238
skinparam NoteBackgroundColor #FFFBEA
skinparam NoteBorderColor #C8BE8A
skinparam sequence {
  LifeLineBorderColor #607D8B
  ParticipantBorderColor #455A64
  ParticipantBackgroundColor #F8FAFC
  ActorBorderColor #263238
  ActorBackgroundColor #FFFFFF
  GroupBorderColor #455A64
  GroupBackgroundColor #F8FAFC
  ActivationBorderColor #455A64
  ActivationBackgroundColor #FFFFFF
}
title UC-04 Build Weekly Roster

participant "roster:RosterControl" as roster <<control>> #FFF3DA
participant "slot:RosterSlot" as slot <<entity>> #EDF6EC
participant "audit:AuditEntry" as audit <<entity>> #EDF6EC
database "db:Database" as db #F1F5F9

' Sample decomposition; behavioural scope, bindings and source mappings: README.md.
' Database messages use the requested business-operation abstraction; see README.md.
note over roster, db
  A roster week has been selected.
end note
activate roster
roster -> db: retrieveOrCreateRosterData(week)
activate db
db -->> roster: weeklyRoster, planningData, wasCreated
deactivate db
opt an empty draft was created
  roster -> audit: recordChange("draft created", actor, time,\nnull, draft, null)
  activate audit
  audit -->> roster: auditData
  deactivate audit
  roster -> db: saveAuditRecord(auditData)
  activate db
  db -->> roster: draft-creation audit entry stored
  deactivate db
end
opt roster status is draft
  loop for each existing slot
    roster -> slot: staffingStatus(slotAssignments, crewPolicy)
    activate slot
    slot -->> roster: missingRoles, staffRequired, isFullyStaffed
    deactivate slot
  end
end
deactivate roster
/'
Original SQL retained for the associated operation:
-- Retrieve the selected week's roster
SELECT * FROM WeeklyRoster
WHERE rosterWeek = :week;

-- Create an empty draft for this week
INSERT INTO WeeklyRoster (rosterWeek, status)
VALUES (:week, 'draft');

-- Record creation of this week's draft
INSERT INTO AuditEntry
(actingUser, timestamp, previousValue, newValue, reason)
VALUES (:actor, :time, :previous, :new, :reason);

-- Retrieve roster details and staff availability
SELECT * FROM WeekPlanningView
WHERE rosterWeek = :week;
'/
@enduml
